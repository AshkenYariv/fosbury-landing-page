# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon serverless Postgres) ---
# Pooled connection string for app runtime (PgBouncer).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Direct (unpooled) connection for migrations.
DIRECT_DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Secrets / envelope encryption ---
# 32-byte base64 key for symmetric encryption of OAuth tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Inngest (durable jobs / cron) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Meta Marketing API (dev/sandbox app first) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
# Graph API version, e.g. v21.0
META_GRAPH_API_VERSION=v21.0

# --- Shopify (dev partner app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/shopify/callback
SHOPIFY_WEBHOOK_SECRET=

# --- Creative generation (external API: Creatify / Arcads-style) ---
CREATIVE_API_BASE_URL=
CREATIVE_API_KEY=
# Optional separate image-generation provider
IMAGE_API_BASE_URL=
IMAGE_API_KEY=

# --- Analytics (carried over from prior site) ---
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
