# Where every "Book a demo" CTA points. Defaults to the Fosbury Calendly link.
NEXT_PUBLIC_BOOK_DEMO_URL=https://calendly.com/ashkenazy-jariv/fosbury-intro

# Optional. When set, <Analytics /> renders the Plausible script. Leave empty in dev.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Used in OG images and JSON-LD canonical URLs.
NEXT_PUBLIC_SITE_URL=https://fosbury.com
