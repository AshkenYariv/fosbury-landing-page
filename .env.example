# Where every "Book a demo" CTA points. Defaults to the Fosbury Calendly link.
NEXT_PUBLIC_BOOK_DEMO_URL=https://calendly.com/ashkenazy-jariv/fosbury-intro

# Optional. Overrides the Umami website ID baked into <Analytics />. Set this
# in `.env.local` to a separate dev/staging website so localhost clicks don't
# pollute production analytics. If unset, the prod ID in components/ui/Analytics.tsx
# is used.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Used in OG images and JSON-LD canonical URLs.
NEXT_PUBLIC_SITE_URL=https://fosbury.ai
